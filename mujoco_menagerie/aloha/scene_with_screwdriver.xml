    <mesh name="cup_outer_mesh" file="cup_outer.obj"/>
    <mesh name="cup_inner_mesh" file="cup_inner.obj"/>
    <mesh name="cup_rim_mesh" file="cup_rim.obj"/>

    <!-- Materials & Textures -->
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="metal" rgba="0.517 0.529 0.537 1"/>
    
    <!-- Exact Real-World Video Visuals -->
    <material name="black_table" rgba="0.12 0.13 0.15 1" specular="0.1" shininess="0.1"/>
    <material name="white_tape" rgba="0.90 0.90 0.92 1" specular="0.2" shininess="0.1"/>
    <material name="screwdriver_handle" rgba="0.95 0.88 0.25 1" specular="0.4" shininess="0.3"/>
    <material name="screwdriver_metal" rgba="0.82 0.84 0.88 1" specular="0.9" shininess="0.9"/>
    
    <!-- Blue Paper Cup with White Interior and Yellow Sponge inside (1-to-1 match with real_frame_0.jpg) -->
    <material name="cup_blue_outer" rgba="0.15 0.65 0.92 1" specular="0.4" shininess="0.3"/>
    <material name="cup_white_rim" rgba="0.95 0.95 0.97 1" specular="0.3" shininess="0.2"/>
    <material name="cup_sponge_yellow" rgba="0.85 0.82 0.28 1" specular="0.1" shininess="0.1"/>
  </asset>

  <default>
