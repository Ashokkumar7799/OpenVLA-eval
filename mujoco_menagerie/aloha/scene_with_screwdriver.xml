      <!-- High friction rubber handle so grippers firmly lock without slipping -->
      <geom name="screwdriver_grip" type="cylinder" size="0.013 0.038" pos="0 0 0.038" material="screwdriver_handle" mass="0.04" friction="2.0 0.1 0.002" condim="4"/>
      <!-- Metal Shaft -->
      <geom name="screwdriver_shaft" type="cylinder" size="0.0035 0.045" pos="0 0 -0.045" material="screwdriver_metal" mass="0.03" friction="1.5 0.1 0.001" condim="4"/>
